# ProtonVPN via gluetun — see https://github.com/qdm12/gluetun-wiki/blob/main/setup/providers/protonvpn.md
# Get WIREGUARD_PRIVATE_KEY from a WireGuard config generated at
# account.protonvpn.com -> Downloads -> WireGuard configuration
# (copy the "PrivateKey" line — WIREGUARD_ADDRESSES is not needed for this provider).
# Check "Use existing key" on later downloads so the key doesn't rotate.
VPN_SERVICE_PROVIDER=protonvpn
WIREGUARD_PRIVATE_KEY=

# Optional location filters (leave blank for any server)
SERVER_COUNTRIES=

# Requires a Plus/Unlimited/Visionary plan. gluetun requests the forwarded
# port itself via Proton's API — the port is random and shown in gluetun's logs.
VPN_PORT_FORWARDING=off

# qBittorrent
PUID=1000
PGID=1000
TZ=Etc/UTC

# Host path containing incomplete/ and complete/{books,video,audio,unsorted}/
# subfolders — see torrents/README.md for the qBittorrent WebUI settings
# that point "keep incomplete torrents in" / per-category save paths at them.
DOWNLOADS_LOCATION=/mnt/nas/downloads
