.env
.env.local
*.env
!*.env.example

# Home Assistant: only track hand-authored config, not runtime state/deps/db/logs
home-assistant/config/*
!home-assistant/config/*.yaml
home-assistant/config/secrets.yaml

# ring-mqtt: ring-state.json holds a live Ring account auth token
home-assistant/ring-mqtt/ring-state.json

# torrents: gluetun holds VPN state/keys, qbittorrent config is runtime state
torrents/gluetun/
torrents/qbittorrent/config/

# calibre-web-automated: config is runtime state (app.db holds users + SMTP creds); ingest is a transient drop folder
calibre-web-automated/config/
calibre-web-automated/ingest/
